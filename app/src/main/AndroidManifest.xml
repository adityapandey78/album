<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet is used ONLY by Settings > Updates and, when asked, the describe-it search download (both from GitHub
         releases). The gallery itself never goes online. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- In-app updates: Album installs its own newer versions through Android's installer, after Android asks.
         Play Protect may warn about apps from unknown developers that can install apps; the user decides. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Read-only access to photos and videos. Changes (delete, favourite) always go through MediaStore requests. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <!-- Off until the user turns on "Media management" in Android settings (Settings > Delete and favourite without pop-ups).
         Then those requests complete without Android's pop-up; Album offers Undo for trash and asks itself before deleting forever. -->
    <uses-permission android:name="android.permission.MANAGE_MEDIA" />
    <!-- Where photos were taken (EXIF GPS), for Places. Turned into a town name on the phone, never sent anywhere. -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
    <!-- A big organising pass (first index, faces, clean-up scan) keeps running after Album leaves the screen, with a quiet
         notification, instead of a slice per visit. Media processing on Android 15+, data sync before. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Private safe: asks for the fingerprint (or the screen lock) through Android's own prompt before it opens. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- On this day (Settings, off by default): at most one quiet notification a day. Android 13+ asks before any. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Added by WorkManager and ML Kit's telemetry; nothing here watches the network (no network constraints, telemetry cut below). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <!-- Edit lists the apps that can edit a photo or video ("Edit with"). Without this, Android hides them from Album. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.EDIT" />
            <data android:mimeType="image/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.EDIT" />
            <data android:mimeType="video/*" />
        </intent>
        <!-- Clean up, For you and Storage show the launcher icon of the app a folder belongs to (MediaApp in StorageScreen.kt). -->
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <package android:name="org.telegram.messenger" />
        <package android:name="com.instagram.android" />
        <package android:name="com.snapchat.android" />
        <package android:name="com.facebook.orca" />
        <package android:name="com.facebook.katana" />
    </queries>

    <application
        android:name=".AlbumApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher_lime"
        android:label="@string/app_name"
        android:theme="@style/Theme.Album">

        <!-- ML Kit sends usage telemetry (Firelog) through Google's datatransport. Without its backend and schedulers,
             events are dropped before they are stored or sent. Its Play services telemetry is stripped in proguard-rules.pro. -->
        <service android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery" tools:node="remove" />
        <service android:name="com.google.android.datatransport.runtime.scheduling.jobscheduling.JobInfoSchedulerService" tools:node="remove" />
        <receiver android:name="com.google.android.datatransport.runtime.scheduling.jobscheduling.AlarmManagerSchedulerBroadcastReceiver" tools:node="remove" />

        <!-- WorkManager starts on first use (AlbumApp.workManagerConfiguration) instead of on the main thread at every launch. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:node="merge">
            <meta-data android:name="androidx.work.WorkManagerInitializer" tools:node="remove" />
        </provider>

        <!-- WorkManager's own service, which runs those long passes; declared here only to give it its types -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="mediaProcessing|dataSync"
            tools:node="merge" />

        <!-- Share as ZIP: the app picked in the share sheet reads the ZIP from Album's cache through this, with a one-off grant.
             Not exported; nothing else in Album's storage is reachable through it (res/xml/zip_paths.xml). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.zip"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/zip_paths" />
        </provider>

        <receiver
            android:name=".InstallResultReceiver"
            android:exported="false" />

        <!-- The Memories home-screen widget (MemoryWidget.kt). Exported so the launcher can place and update it. -->
        <receiver
            android:name=".MemoryWidgetReceiver"
            android:exported="true"
            android:label="Memories">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/memory_widget" />
        </receiver>

        <!-- The Person, Album and Favourites widgets (Widgets.kt), exported like the Memories widget. Their labels are
             the names in the launcher's widget list. -->
        <receiver
            android:name=".PersonWidgetReceiver"
            android:exported="true"
            android:label="Person">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/person_widget" />
        </receiver>
        <receiver
            android:name=".AlbumWidgetReceiver"
            android:exported="true"
            android:label="Album">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/album_widget" />
        </receiver>
        <receiver
            android:name=".FavouritesWidgetReceiver"
            android:exported="true"
            android:label="Favourites">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/favourites_widget" />
        </receiver>

        <!-- Choosing who or what a Person or Album widget shows. Exported because the launcher opens it as a widget is
             placed; its own task, so it never brings Album's screens along or stays in Recents. -->
        <activity
            android:name=".WidgetConfigureActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Backup: a drive plugged in starts an automatic backup, or carries on one that unplugging it stopped. The
             media-mounted broadcast needs no permission and reaches Album while it isn't running. Exported because
             Android sends it; a fake one from another app only makes Album look for its drive. -->
        <receiver
            android:name=".BackupMountReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_MOUNTED" />
                <data android:scheme="file" />
            </intent-filter>
        </receiver>

        <!-- adjustResize: the keyboard is an inset Compose pads for (search sits at the bottom), not a pan of the window -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />

        <!-- The home-screen entries: one per accent, so the icon's sun can follow it, and one per disguise (below).
             LauncherIcon keeps exactly one enabled; lime until the accent or a disguise says otherwise. -->
        <activity-alias
            android:name=".IconLime"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_lime"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconCoral"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_coral"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconSky"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_sky"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconAmber"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_amber"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconMono"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_mono"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconWallpaper"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_wallpaper"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- The disguises (Disguise.kt): Album's entry under the name and icon of an app found on most work phones, so it
             isn't seen as a gallery. The label is also what recent apps show. Labels match Disguise.label (DisguiseTest). -->
        <activity-alias
            android:name=".DisguiseCalculator"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_disguise_calculator"
            android:label="Calculator"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".DisguiseClock"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_disguise_clock"
            android:label="Clock"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".DisguiseCompass"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_disguise_compass"
            android:label="Compass"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".DisguiseNotes"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_disguise_notes"
            android:label="Notes"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".DisguiseFiles"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_disguise_files"
            android:label="Files"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".DisguiseScanner"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_disguise_scanner"
            android:label="Scanner"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".DisguiseAuthenticator"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_disguise_authenticator"
            android:label="Authenticator"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".DisguiseWorkspace"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_disguise_workspace"
            android:label="Workspace"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- "Open with Album" for photos and videos from other apps. Shows just that file, with Share and Details. -->
        <activity
            android:name=".ExternalViewerActivity"
            android:exported="true"
            android:theme="@style/Theme.Album.Viewer">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>
    </application>
</manifest>
