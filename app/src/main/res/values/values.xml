<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Album</string>
    <color name="launcher_bg">#FF4F46E5</color>

    <style name="Theme.Album" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- Black from the first frame, so opening a photo from another app never flashes white. -->
    <style name="Theme.Album.Viewer">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
