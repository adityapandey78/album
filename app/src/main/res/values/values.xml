<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Album</string>
    <string name="memory_widget_description">A photo from this day in earlier years, a recent trip or a favourite</string>
    <color name="launcher_bg">#FF111110</color>

    <style name="Theme.Album" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <!-- The launch splash: the icon on #111110 (design system: Logo), gone with the first frame of the grid -->
        <item name="android:windowSplashScreenBackground">@color/launcher_bg</item>
    </style>

    <!-- Black from the first frame, so opening a photo from another app never flashes white. -->
    <style name="Theme.Album.Viewer">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
