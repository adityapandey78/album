<?xml version="1.0" encoding="utf-8"?>
<!-- Cloud backup is off (allowBackup="false"). Moving to a new phone still copies app data, but the collections and smart
     index databases store MediaStore ids, which differ on the new phone: they'd point at the wrong photos, so they stay behind.
     The private safe never leaves the phone: its files are useless without this phone's Keystore key, which can't be copied,
     and a safe that arrives but can't open would look like lost photos. Excluded from cloud backup too, should it ever be on. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="safe" />
        <exclude domain="database" path="safe.db" />
        <exclude domain="database" path="safe.db-wal" />
        <exclude domain="database" path="safe.db-shm" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="cleanup.xml" /> <!-- Clean up's kept photos, by MediaStore id too -->
        <exclude domain="file" path="safe" />
    </device-transfer>
</data-extraction-rules>
